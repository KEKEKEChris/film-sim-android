<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The editor is a darkroom whichever way the system is set, so both themes are the black one:
         the window behind Flutter, and the splash before its first frame, are the warm page. The
         status bar is left to Flutter, which paints the appearance's own colour behind it. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/warm_page</item>
    </style>
</resources>
