# Shell scripts, Swift, Dart and the build files run on Linux CI. A CRLF in any of them turns into a
# "bad interpreter" or a stray \r in a string, so line endings are normalised to LF in the repository
# and on checkout, whatever the editing machine does.
* text=auto eol=lf

*.sh    text eol=lf
*.bash  text eol=lf
*.py    text eol=lf
*.swift text eol=lf
*.dart  text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.env   text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.otf   binary
*.ttf   binary
*.ttc   binary
*.icns  binary
*.xcassets binary
*.zip   binary
*.a     binary
*.so    binary
*.dylib binary
*.jks   binary
*.keystore binary
