Let a phone's Vulkan device exist: 8-bit storage is optional in 1.1, not required.

Adreno 660 (Snapdragon 888, OnePlus 9) reports Vulkan 1.1 — the 1.3 in vkjson is the loader's,
not the driver's — and does not offer VK_KHR_8bit_storage, which only became core in 1.2.
Halide required it for every 1.1 device, so validation failed before vkCreateDevice was ever
called: the context never existed, copy_to_device returned -16, and the engine had no developer.
8-bit storage is now optional, where a driver that has it still gets it.

Also fixes the queue-family block, which was sized as sizeof(VkPhysicalDevice) — the 8-byte
handle — while the driver wrote VkQueueFamilyProperties into it, about 24 bytes a family. And
the steps that used to report through debug(), compiled out of a release runtime, now report
through error(), so the next failure names itself instead of arriving as silence.

diff --git a/src/runtime/vulkan_context.h b/src/runtime/vulkan_context.h
--- a/src/runtime/vulkan_context.h
+++ b/src/runtime/vulkan_context.h
--- a/src/runtime/vulkan_context.h
+++ b/src/runtime/vulkan_context.h
@@ -292,7 +292,9 @@
 
             // allocate enough storage for the queue properties query results
             BlockStorage::Config queue_properties_storage_config;
-            queue_properties_storage_config.entry_size = sizeof(VkPhysicalDevice);
+            // Each entry is a VkQueueFamilyProperties, not a VkPhysicalDevice: the query writes
+            // about 24 bytes a family, and sizing the block for the 8-byte handle wrote past it.
+            queue_properties_storage_config.entry_size = sizeof(VkQueueFamilyProperties);
             BlockStorage queue_properties_storage(user_context, queue_properties_storage_config);
             queue_properties_storage.resize(user_context, queue_properties_count);
 
@@ -335,7 +337,10 @@
     uint32_t minor_version = VK_API_VERSION_MINOR(device_properties.apiVersion);
     bool has_capability_v11 = (major_version >= 1) && (minor_version >= 1);  // supports >= v1.1
     bool has_capability_v12 = (major_version >= 1) && (minor_version >= 2);  // supports >= v1.2
-    debug(user_context) << "  found device compute capability v" << major_version << "." << minor_version << " ...\n";
+    // The version decides which extensions are still extensions — everything promoted to core
+    // is skipped. A phone that reports 1.0 here asks for extension names its driver no longer
+    // lists, and the validation below then fails with nothing to show for it.
+    error(user_context) << "Vulkan: device computes v" << major_version << "." << minor_version << "\n";
 
     debug(user_context) << "  checking for required device extensions ...\n";
     StringTable required_device_extensions;
@@ -351,13 +356,14 @@
 
     bool valid_device = vk_validate_required_extension_support(user_context, required_device_extensions, supported_device_extensions);
     if (!valid_device) {
-        debug(user_context) << "Vulkan: Unable to validate required extension support!\n";
+        error(user_context) << "Vulkan: Unable to validate required extension support!\n";
         return halide_error_code_device_interface_no_device;
     }
 
-    debug(user_context) << "  found " << (uint32_t)required_device_extensions.size() << " required extensions for device!\n";
+    error(user_context) << "Vulkan: " << (uint32_t)required_device_extensions.size()
+                        << " required extensions for device\n";
     for (uint32_t n = 0; n < required_device_extensions.size(); ++n) {
-        debug(user_context) << "   required extension: " << required_device_extensions[n] << "\n";
+        error(user_context) << "Vulkan:   required: " << required_device_extensions[n] << "\n";
     }
 
     // enable all available optional extensions
@@ -444,7 +450,27 @@
 
     VkResult result = vkCreateDevice(*physical_device, &device_create_info, alloc_callbacks, device);
     if (result != VK_SUCCESS) {
-        debug(user_context) << "Vulkan: vkCreateDevice failed with return code: " << vk_get_error_name(result) << "\n";
+        // A mobile driver can answer a feature query and then refuse the same bits back in a
+        // device. Ask again with less each time, and say what it answered.
+        error(user_context) << "Vulkan: vkCreateDevice refused the reported features: "
+                            << vk_get_error_name(result) << "\n";
+        storage_16bit_ext.pNext = nullptr;
+        result = vkCreateDevice(*physical_device, &device_create_info, alloc_callbacks, device);
+    }
+    if (result != VK_SUCCESS) {
+        error(user_context) << "Vulkan: vkCreateDevice refused 16-bit storage: "
+                            << vk_get_error_name(result) << "\n";
+        device_create_info.pNext = nullptr;
+        device_create_info.pEnabledFeatures = nullptr;
+        device_create_info.enabledExtensionCount = 0;
+        device_create_info.ppEnabledExtensionNames = nullptr;
+        device_create_info.enabledLayerCount = 0;
+        device_create_info.ppEnabledLayerNames = nullptr;
+        result = vkCreateDevice(*physical_device, &device_create_info, alloc_callbacks, device);
+    }
+    if (result != VK_SUCCESS) {
+        error(user_context) << "Vulkan: vkCreateDevice refused even a bare device: "
+                            << vk_get_error_name(result) << "\n";
         return halide_error_code_device_interface_no_device;
     }
 

diff --git a/src/runtime/vulkan_extensions.h b/src/runtime/vulkan_extensions.h
--- a/src/runtime/vulkan_extensions.h
+++ b/src/runtime/vulkan_extensions.h
@@ -198,9 +198,11 @@
         VK_KHR_STORAGE_BUFFER_STORAGE_CLASS_EXTENSION_NAME};  // promoted to core in v1.1
     const uint32_t before_v1p1_ext_count = sizeof(before_v1p1_ext_table) / sizeof(before_v1p1_ext_table[0]);
 
+    // 8-bit storage is core in 1.2 and only an extension in 1.1, where a driver need not offer
+    // it: Adreno 660 (Vulkan 1.1, Snapdragon 888) does not, so requiring it kept the device from
+    // ever being created. It is offered as optional below, where a driver that has it still gets it.
     const char *before_v1p2_ext_table[] = {
-        before_v1p1_ext_table[0],
-        VK_KHR_8BIT_STORAGE_EXTENSION_NAME};  // promoted to core in v1.2
+        before_v1p1_ext_table[0]};
     const uint32_t before_v1p2_ext_count = sizeof(before_v1p2_ext_table) / sizeof(before_v1p2_ext_table[0]);
 
     uint32_t required_ext_count = 0;
@@ -225,6 +227,7 @@
 
     const char *before_v1p2_ext_table[] = {
         before_v1p1_ext_table[0],
+        VK_KHR_8BIT_STORAGE_EXTENSION_NAME,            //< promoted to core in v1.2, optional in 1.1
         "VK_KHR_portability_subset",                   //< requires v1.1, always optional, necessary for running under Molten (aka Vulkan on Mac)
         VK_KHR_SHADER_FLOAT16_INT8_EXTENSION_NAME,     //< promoted to core in v1.2
         VK_KHR_SHADER_FLOAT_CONTROLS_EXTENSION_NAME};  //< promoted to core in v1.2
